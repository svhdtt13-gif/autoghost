<Window x:Class="AutoGhost.App.ClientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Client ID"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Client ID" FontWeight="SemiBold" />
        <TextBlock Text="Must exactly match the Role ID parsed from the live title bar." Foreground="#667085" TextWrapping="Wrap" Margin="0,4,0,12" />
        <TextBox x:Name="ClientIdBox" MinWidth="340" />
        <TextBlock Text="Special Items (optional; one item per line)" FontWeight="SemiBold" Margin="0,14,0,4" />
        <TextBlock Text="Leave empty until the operator provides the client-specific list. Empty means no alert is inferred." Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBox x:Name="SpecialItemsBox" MinWidth="340" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="OnCancel" IsCancel="True" />
            <Button Content="Add" Click="OnSave" IsDefault="True" Background="#2563EB" Foreground="White" />
        </StackPanel>
    </StackPanel>
</Window>
