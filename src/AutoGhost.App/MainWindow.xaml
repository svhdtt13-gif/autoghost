<Window x:Class="AutoGhost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoGhost — P2 Recorder / Action Model"
        Width="1240"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        Background="{StaticResource WindowBackgroundBrush}"
        Loaded="OnLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="AutoGhost" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="P2 · Recorder + Action Model (dry-run only)" Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Command="{Binding KillSwitchCommand}"
                    Content="{Binding KillSwitchText}"
                    Background="{StaticResource DangerBrush}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    ToolTip="Safety control. P2 replay is dry-run only and never emits OS input." />
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="P0 feasibility" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="PASS" Foreground="#067647" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Capture note" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="Minimized GPU/frame capture limited" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Input mode" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding AutomationStateText}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Registry file" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding RegistryPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RegistryPath}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Process name" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Role ID title regex" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox Text="{Binding RoleIdRegex, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Command="{Binding AddClientCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Content="Add client" />
                    <Button Command="{Binding RemoveClientCommand}" Content="Remove selected" />
                    <Button Command="{Binding ToggleClientCommand}" Content="Enable / disable" />
                    <Button Command="{Binding SaveCommand}" Content="Save registry" Background="{StaticResource AccentBrush}" Foreground="White" />
                    <Button Command="{Binding RefreshCommand}" Content="Refresh runtime" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="P2 recorder target" Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox ItemsSource="{Binding Clients}"
                              SelectedItem="{Binding SelectedRecordingClient, Mode=TwoWay}"
                              DisplayMemberPath="ClientId" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Action name" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox Text="{Binding ActionName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Command="{Binding StartRecordingCommand}" Content="Start record" Background="{StaticResource AccentBrush}" Foreground="White" />
                    <Button Command="{Binding StopRecordingCommand}" Content="Stop record" />
                    <Button Command="{Binding SaveActionCommand}" Content="Save action" />
                    <Button Command="{Binding DryRunCommand}" Content="Dry-run" />
                    <Button Command="{Binding PauseResumeDryRunCommand}" Content="Pause / resume" />
                    <Button Command="{Binding StopDryRunCommand}" Content="Stop dry-run" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                    <TextBlock Text="{Binding P2Status}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding P2Status}" />
                    <TextBlock Text="   Steps: " Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding RecordedStepCount}" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="   Last: " Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding LastReplayEvent}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastReplayEvent}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
            <DataGrid ItemsSource="{Binding Clients}"
                      SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Client ID" Binding="{Binding ClientId}" Width="1.4*" />
                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="90" />
                    <DataGridTextColumn Header="Special Items" Binding="{Binding SpecialItemsSummary}" Width="2*" />
                    <DataGridTextColumn Header="Runtime" Binding="{Binding RuntimeState}" Width="130" />
                    <DataGridTextColumn Header="Observed Role ID" Binding="{Binding ObservedRoleId}" Width="150" />
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="90" />
                    <DataGridTextColumn Header="HWND" Binding="{Binding WindowHandle}" Width="105" />
                    <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" Width="230" />
                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="5" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Special Items for selected client" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="One item per line; empty means pending/no alert." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBox Grid.Column="1"
                         Text="{Binding SelectedClient.SpecialItemsText, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="44"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="6" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Last refresh: " Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="{Binding LastRefresh}" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
